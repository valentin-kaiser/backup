                      ]
                    },
                    "jsonrpc": {
                      "const": "2.0"
                    },
                    "result": {
                      "$ref": "#/components/schemas/backup.api.v1.ExportAuditLogResponse"
                    }
                  },
                  "required": [
                    "jsonrpc",
                    "id"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "JSON-RPC 2.0 response with either `result` or `error`."
          },
          "default": {
            "description": "Error"
          }
        },
        "summary": "Returns the matching entries as a file.",
        "tags": [
          "AuditLog"
        ]
      }
    },
